# Emulator / local only — never commit real keys.
#
# REQUIRED: Galya SECRET key (server / Cloud Functions)
#   galya_wsk_…  preferred (workspace secret)
#   galya_sk_…   account secret — also set GALYA_WORKSPACE_ID
#
# FORBIDDEN here: publishable keys (galya_wpub_… / galya_pub_…)
#   Those are for browser + iOS SDKs only.

GALYA_API_KEY=galya_wsk_…

# Required only when using an account secret (galya_sk_…) instead of galya_wsk_
# GALYA_WORKSPACE_ID=ws_…
