# Workspace secret from Galya Dashboard → workspace → API keys → Secret keys
# (required for sync + callables)
GALYA_API_KEY=galya_wsk_…

# Required only when using an account secret (galya_sk_…) instead of galya_wsk_
# GALYA_WORKSPACE_ID=ws_…

# Optional override (default https://api.galya.io/v1)
# GALYA_BASE_URL=https://api.galya.io/v1

# Optional path to sync config (default: ./galya.sync.json)
# GALYA_SYNC_CONFIG=
