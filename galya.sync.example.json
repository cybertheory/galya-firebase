{
  "version": 1,
  "defaults": {
    "domain": "shopping",
    "batchSize": 50,
    "idField": "galyaEntityId",
    "writeBack": true
  },
  "collections": [
    {
      "path": "products",
      "domain": "shopping",
      "type": "image",
      "fields": ["title", "description", "imageUrl", "category", "status", "draft"],
      "url": "{{imageUrl}}",
      "content": "{{title}}\n{{description}}\nCategory: {{category}}",
      "ref": "{{id}}",
      "skipUrlFetch": false,
      "rules": {
        "includeWhen": { "status": "published" },
        "excludeWhen": { "draft": true }
      }
    },
    {
      "path": "listings",
      "domain": "travel",
      "type": "text",
      "fields": ["title", "body", "coverUrl", "visible"],
      "url": "https://example.com/listings/{{id}}",
      "content": "{{title}}\n{{body}}\nCover: {{coverUrl}}",
      "skipUrlFetch": true,
      "rules": {
        "includeWhen": { "visible": true }
      }
    }
  ]
}
